{
  "name": "diagramdesk",
  "productName": "DiagramDesk",
  "version": "0.2.3",
  "description": "A local desktop app for flowcharts, Gantt charts, mind maps, and more, typed by hand or described to a local AI. Built on Mermaid, from Guided AI Labs.",
  "main": "dist/electron/main.js",
  "author": {
    "name": "Adam Goodwin",
    "email": "adamgoodwin@shaw.ca"
  },
  "homepage": "https://github.com/Adamgdwn/diagramdesk",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "generate:icons": "node scripts/run-generate-icons.mjs",
    "build:renderer": "npm run typecheck && vite build",
    "build:electron": "node scripts/clean-electron-build.mjs && tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start:built": "node scripts/start-electron.mjs",
    "start": "npm run build && npm run start:built",
    "install:desktop": "node scripts/install-desktop.mjs",
    "package:win": "npm run generate:icons && npm run build && electron-builder --win nsis --publish never",
    "package:mac": "npm run generate:icons && npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run generate:icons && npm run build && electron-builder --linux AppImage deb --publish never",
    "package:dir": "npm run generate:icons && npm run build && electron-builder --dir --publish never",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "mermaid": "^11.14.0",
    "monaco-editor": "0.53.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.0.8",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "mermaid": {
      "katex": "^0.18.2"
    },
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  },
  "build": {
    "appId": "com.adamgoodwin.diagramdesk",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "mmd",
        "name": "Mermaid Diagram",
        "description": "Mermaid diagram source file",
        "mimeType": "text/x-mermaid",
        "role": "Editor"
      },
      {
        "ext": "mermaid",
        "name": "Mermaid Diagram",
        "description": "Mermaid diagram source file",
        "mimeType": "text/x-mermaid",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "DiagramDesk-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "artifactName": "DiagramDesk-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "extraResources": [
        {
          "from": "packaging/linux/mime",
          "to": "mime"
        }
      ],
      "category": "Graphics",
      "desktop": {
        "entry": {
          "Comment": "Guided AI Labs local diagram app with live preview and export, built on Mermaid",
          "MimeType": "text/x-mermaid;application/x-mermaid;text/plain;",
          "StartupWMClass": "DiagramDesk"
        }
      },
      "executableArgs": [
        "--no-sandbox",
        "--disable-gpu",
        "--disable-gpu-compositing",
        "--disable-software-rasterizer",
        "--in-process-gpu"
      ],
      "executableName": "diagramdesk",
      "icon": "icon.png",
      "mimeTypes": [
        "text/x-mermaid",
        "application/x-mermaid"
      ],
      "maintainer": "Adam Goodwin <adamgoodwin@shaw.ca>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "deb": {
      "afterInstall": "packaging/linux/after-install.sh",
      "afterRemove": "packaging/linux/after-remove.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libdrm2",
        "libgbm1"
      ]
    }
  }
}
